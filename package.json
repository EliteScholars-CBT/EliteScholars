{
  "name": "react",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@upstash/redis": "^1.38.0",
    "react": "^18.1.0",
    "react-dom": "^18.1.0",
    "react-router-dom": "^7.5.1",
    "recharts": "^2.10.3",
    "resend": "^3.2.0",
    "web-push": "^3.6.7"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "DISABLE_ESLINT_PLUGIN=true CI=false react-scripts build",
    "obfuscate": "javascript-obfuscator build/static/js --output build/static/js --compact true --string-array true --rotate-string-array true --string-array-threshold 0.75 --dead-code-injection false --self-defending true --disable-console-output true",
    "build:prod": "node scripts/build-blog.js && react-scripts build && npm run obfuscate",
    "test": "react-scripts test --env=jsdom",
    "eject": "react-scripts eject",
    "prebuild": "node scripts/build-blog.js",
    "blog": "node scripts/build-blog.js"
  },
  "devDependencies": {
    "javascript-obfuscator": "^4.2.2",
    "prettier": "^3.8.3",
    "react-scripts": "latest"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}