# Copy to .env (local) / set in Vercel → Settings → Environment Variables. Never commit real values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
HASH_SALT=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_NOTIFY_EMAIL=
PARTNER_DATA_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
RESEND_API_KEY=
FROM_EMAIL=
APP_ORIGIN=https://elitescholars.site
SITE_URL=https://elitescholars.site
CRON_SECRET=
VERCEL_DEPLOY_HOOK_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: AI rewrite for "Study from your files" (falls back to on-device engine when empty)
# One variable holds every AI key. JSON array, one object per key, each with its own settings:
# provider = gemini | anthropic | openai ; weight = how often it is picked ; model/maxTokens/temperature/enabled optional.
# AI_KEYS=[{"name":"gemini-a","provider":"gemini","key":"AIza...","model":"gemini-2.5-flash","weight":3},{"name":"claude-a","provider":"anthropic","key":"sk-ant-...","weight":2},{"name":"gpt-a","provider":"openai","key":"sk-...","model":"gpt-4o-mini","weight":1}]
AI_KEYS=
# (older single-key setup, still works when AI_KEYS is empty)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Admin email centre: CampMailer channel (optional)
CAMPMAILER_URL=
CAMPMAILER_API_KEY=
# Web push (streak reminders + assignment alerts). Generate your own pair: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@elitescholars.site
